{
	"name": "typespec-http-mcp",
	"version": "0.1.0",
	"description": "TypeSpec emitter: generate an MCP tool surface, and the Zod validators it publishes, from an HTTP service definition, dispatching into the same handlers a generated HTTP server calls.",
	"keywords": [
		"cloudflare-workers",
		"codegen",
		"mcp",
		"model-context-protocol",
		"openapi",
		"typespec",
		"typespec-emitter",
		"zod"
	],
	"homepage": "https://github.com/bison-digital/typespec-http-mcp#readme",
	"bugs": {
		"url": "https://github.com/bison-digital/typespec-http-mcp/issues"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/bison-digital/typespec-http-mcp.git"
	},
	"files": [
		"!dist/test/**",
		"dist/**",
		"lib/*.tsp",
		"src/runtime.ts"
	],
	"type": "module",
	"main": "dist/src/index.js",
	"exports": {
		".": {
			"typespec": "./lib/main.tsp",
			"types": "./dist/src/index.d.ts",
			"default": "./dist/src/index.js"
		},
		"./runtime": {
			"types": "./dist/src/runtime.d.ts",
			"default": "./dist/src/runtime.js"
		}
	},
	"publishConfig": {
		"access": "public",
		"provenance": true
	},
	"scripts": {
		"build": "tsc -p tsconfig.build.json",
		"test": "tsc -p tsconfig.build.json && vitest run",
		"test:unit": "tsc -p tsconfig.build.json && vitest run --project unit",
		"typecheck": "tsc -p tsconfig.json",
		"lint": "oxlint src/ test/",
		"format": "oxfmt",
		"format:check": "oxfmt --check"
	},
	"dependencies": {
		"typespec-http-zod": "^0.25.0"
	},
	"devDependencies": {
		"@hono/zod-validator": "^0.9.0",
		"@modelcontextprotocol/client": "2.0.0",
		"@modelcontextprotocol/server": "2.0.0",
		"@types/node": "^26.0.0",
		"@typespec/compiler": "1.15.0",
		"@typespec/http": "1.15.0",
		"@typespec/http-specs": "0.1.0-alpha.41",
		"@typespec/openapi": "1.15.0",
		"@typespec/openapi3": "1.15.0",
		"@typespec/rest": "0.85.0",
		"@typespec/versioning": "0.85.0",
		"hono": "^4.13.5",
		"oxfmt": "^0.63.0",
		"oxlint": "^1.78.0",
		"typescript": "~7.0.2",
		"typespec-hono": "0.21.0",
		"typespec-http-mcp": "link:.",
		"vitest": "^4.1.9",
		"wrangler": "^4.127.1",
		"zod": "^4.5.2"
	},
	"peerDependencies": {
		"@modelcontextprotocol/server": "^2.0.0",
		"@typespec/compiler": "^1.15.0",
		"@typespec/http": "^1.15.0",
		"zod": "^4.5.0"
	},
	"engines": {
		"node": ">=22.0.0"
	},
	"packageManager": "pnpm@11.21.0",
	"tspMain": "lib/main.tsp"
}
