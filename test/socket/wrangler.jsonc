{
	// The Worker the socket suite deploys. `main` is the documented wiring, compiled from freshly
	// emitted output by `socket.test.ts` before this file is ever read.
	"$schema": "node_modules/wrangler/config-schema.json",
	"name": "typespec-http-mcp-socket",
	"main": "worker.fixture.ts",
	"compatibility_date": "2026-08-01",
	// **No `nodejs_compat`, deliberately.** The flag would let a Node builtin reached from emitted
	// output resolve and run, which is exactly what this suite exists to refuse: `runtime.ts` is
	// copied verbatim into a consumer's build, so a build-time import there is a broken deploy found
	// at deploy time and nowhere earlier. `architecture.test.ts` checks that by reading imports; this
	// checks it by running.
	"compatibility_flags": [],
	// **Port 0, so the OS chooses.** wrangler's default is a fixed 8787: two runs of this suite, or
	// a stray worker from a killed one, collide on it and the second dies with
	// `Address already in use` from inside workerd. The suite reads the port back off the started
	// worker, so nothing here or in the test names one.
	"dev": { "port": 0, "inspector_port": 0 },
	"observability": { "enabled": false },
}
